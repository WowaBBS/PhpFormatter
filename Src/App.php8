<?php
declare(strict_types=1);
namespace Reformat;

Set_Time_Limit(0);

Set_Include_Path(''); //Fix include path for include security

If(GetCwd()===__DIR__)
  $argv[]=GetCwd();
Else
  $LogFile??='.Formatter.log';

Include '_All.php';

//$argv=[$argv[0], 'D:\MyProj\WLib.php\Src\WLib\EventLoop\Save'];
//$argv=[$argv[0], __DIR__];

$checkInPhp??=False;
$dontWrite??=True;

/**
 * Рекурсивно находит PHP-файлы и приводит ключевые слова
 * PHP к нижнему регистру.
 *
 * Использование:
 *   php lowercase_keywords.php /path/to/project
 *
 * Или текущая директория:
 *   php lowercase_keywords.php .
 */

if (Count($argv)<2) { fwrite(STDERR, "Usage: php {$argv[0]} <directory>\n"); exit(1); }

$root = $argv[1];

$Process=New TProcess();
$Process->Init();
$Res=0;
If(Is_File($root)) $Res=$Process->File   ($root)<0? 1:0; Else
If(Is_Dir ($root)) $Res=$Process->Folder ($root)<0? 1:0; Else
{
  Log('Error', $root, ' not found');
}

$Process->Dispose();
$Loader->Dispose();

Exit($Res);