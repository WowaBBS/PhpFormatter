<?
namespace Reformat\Linked;

Include '../All.php';

use function Reformat\Log;

//Include_Once 'List.php';

Class TTree Implements \IteratorAggregate
{
  Use TNode, TList;
  Var $Name='Node';
  
  Function __Construct($Name) { $this->Name=$Name; }
  
  Function Show($Tab='')
  {
    $Parent=$this->Parent;
    Log('Log', $Tab, $this->Name);
    $Tab.='+ ';
    For($Item=$this->First; $Item; $Item=$Item->Next)
      $Item->Show($Tab);
  }
}

$Tree=New TTree("Root");
$Tree->Add(New TTree("Node1"));
$Tree->Add(New TTree("Node2"));
Assert($Tree->Last->Parent===$Tree);
$Tree->Last->Insert(New TTree("Node3"));
//$Tree->Last->Parent=$Tree;
$Tree->Show();

$Tree->Add(New TTree("Node4"));

ForEach($Tree->First->Next->IterateUntil($Tree->Last->Prev) As $k=>$Item)
  Log('Log', 'IterateUntil ', $k, ': ',$Item->Name);

ForEach($Tree As $k=>$Item)
  If($Item->Name==='Node2' || $Item->Name==='Node4')
    $Item->Remove();
ForEach($Tree As $k=>$Item)
  Log('Log', ' ', $k, ': ',$Item->Name);

//Log('Debug')->Debug($Tree);

$Loader->Done();
 